# ---------------------------------------------------------------------------
# Canvas Jewelry API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Validated at boot by src/config/env.validation.ts — a missing/invalid
# required value aborts startup with a clear error.
# ---------------------------------------------------------------------------

# --- Database (Postgres) ---------------------------------------------------
# All optional here (sensible defaults), but set them in production.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=canvas_jewelry
# MUST stay false in production — schema changes go through migrations only.
DB_SYNCHRONIZE=false

# --- Secrets (REQUIRED) ----------------------------------------------------
# Signs OTP verification tokens / hashes codes. Min 32 chars. Use a random
# value, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-random-32+char-secret
# Shared secret guarding the staff endpoints (/orders*, /admin/translations*).
# Min 16 chars. Rotate by changing this and the admin/dashboard key together.
STAFF_API_KEY=replace-with-a-random-16+char-key

# --- SMS (Twilio) ----------------------------------------------------------
# Optional: if any of the three is missing the server runs in dev mode and
# logs the OTP to the console instead of sending an SMS. Set all three in prod.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- S3 storage for order STLs (REQUIRED) ----------------------------------
AWS_REGION=eu-central-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional key prefix, e.g. "stl/". Defaults to none.
S3_PREFIX=
# Optional custom endpoint for LocalStack/MinIO in dev. Leave empty for real S3.
S3_ENDPOINT=
# Presigned download URL lifetime in seconds.
S3_PRESIGN_TTL_SEC=300

# --- HTTP ------------------------------------------------------------------
# Comma-separated allowed frontend origins (client + admin). REQUIRED in
# production: if left empty, CORS allows ANY origin (dev convenience only).
CORS_ORIGIN=https://your-frontend.example,https://admin.your-frontend.example
PORT=5050
